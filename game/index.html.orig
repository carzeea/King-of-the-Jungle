<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <meta name="theme-color" content="#10150f"><title>King of the Jungle</title>
  <meta name="description" content="King of the Jungle: the ultimate animal fighting game. 11 armored beasts, Tower Mode and Ultra combos. Play free in your browser on phone, PC or controller. Created and Developed by J. Hardy.">
  <meta property="og:type" content="website"><meta property="og:url" content="https://kingofthejunglegame.netlify.app/"><meta property="og:site_name" content="King of the Jungle">
  <meta property="og:title" content="KOTJ: King of the Jungle · Play Free Now">
  <meta property="og:description" content="11 armored beasts. One crown. Can you climb the Tower? Free in your browser on phone, PC or controller. No download.">
  <meta property="og:image" content="https://kingofthejunglegame.netlify.app/og-cover.jpg?v=3"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://kingofthejunglegame.netlify.app/og-cover.jpg?v=3">
  <link rel="stylesheet" href="styles.css?v=9.12">
</head>
<body>
  <div id="splash" aria-hidden="true"><div class="splash-blur"></div><img src="assets/ui/cover.webp?v=7.1" alt="King of the Jungle cover art"><div class="splash-hint">OR PRESS ANY KEY / BUTTON</div></div>
  <script>(function(){var s=document.getElementById('splash'),done=0;function go(e){if(done)return;done=1;if(e){e.preventDefault&&e.preventDefault();e.stopPropagation&&e.stopPropagation()}s.classList.add('out');setTimeout(function(){s.remove()},700)}
  s.addEventListener('pointerdown',go);addEventListener('keydown',function(e){if(!done){go(e)}},{capture:true,once:true});(function pad(){if(done)return;var g=navigator.getGamepads?[].slice.call(navigator.getGamepads()):[];if(g.some(function(x){return x&&x.buttons.some(function(b){return b.pressed})})){go();return}requestAnimationFrame(pad)})()})();</script>
  <div id="backdrop" aria-hidden="true"><div class="bd-img bd-a"></div><div class="bd-img bd-b"></div><div class="bd-rays"></div><div class="bd-vignette"></div><canvas id="bd-embers"></canvas></div>
  <main id="app">
    <header class="topbar"><img class="brand-crown" src="assets/ui/crown.webp" alt=""><div><div class="eyebrow">A LEGACY UNLEASHED</div><h1>KING OF THE JUNGLE</h1></div><div class="build-tag">WEB BUILD · 9.12</div></header>
    <section id="menu" class="screen cover">
      <div class="cover-bg"></div><div class="cover-rays"></div><canvas id="embers" class="cover-embers"></canvas><div class="cover-vignette"></div>
      <div class="cover-hero"><div class="hero-glow"></div><img src="assets/characters/lion/lion-hero.webp" alt="The Lion, King of the Jungle"></div>
      <div class="cover-content">
        <div class="logo">

          <h1 class="title"><img class="crown-fall" src="assets/ui/crown.webp" alt="" aria-hidden="true"><span class="t-small">KING OF THE</span><span class="t-big">JUNGLE</span></h1>
          <p class="tagline">A LEGACY UNLEASHED</p>
          <p class="credit">Created and Developed by <b>J. Hardy</b></p>
        </div>
        <button id="press-start" class="press-start">PRESS START</button>
        <div id="cover-menu" class="cover-menu">
          <button class="primary" data-mode="tower"><b>TOWER MODE</b><small>Climb 10 fights to the throne</small></button>
          <button class="secondary" data-mode="cpu"><b>VS CPU</b><small>Any fighter, any arena</small></button>
          <button class="secondary" data-mode="versus"><b>LOCAL 2 PLAYER</b><small>Same screen, two fighters</small></button>
          <button class="secondary online-btn" data-mode="online"><b>PLAY ONLINE</b><small>Share a code · fight a friend anywhere</small></button>
          <button class="secondary rise-btn hidden" id="rise-btn"><b>MAJIC'S RISE</b><small>How the Jungle Titan was made</small></button>
          <button class="secondary forgotten-btn hidden" data-mode="forgotten"><b>? ? ?</b><small>&nbsp;</small></button>
          <button class="blood-btn cover-setting">BLOOD: OFF</button>
        </div>
      </div>
      <div class="cover-roster"><span>11 FIGHTERS · ONE THRONE</span><div id="cover-faces"></div></div>
      <div class="cover-meta"><span id="cover-build">WEB BUILD · 9.12</span><span>© King of the Jungle · J. Hardy</span></div>
    </section>
    <section id="select" class="screen hidden">
      <div class="select-title"><img class="st-crown" src="assets/ui/crown.webp" alt=""><h2 class="st-main">KING <small>OF THE</small> JUNGLE</h2><p class="st-sub">FIGHTER SELECT</p><p id="select-instruction">Player 1: choose a fighter</p></div>
      <div class="select-layout"><div id="roster" class="roster-grid"></div><aside class="fighter-card"><div class="fighter-number" id="fighter-number">01</div><div class="fighter-portrait"><img id="fighter-portrait" alt=""></div><h3 id="fighter-name">LION</h3><p id="fighter-style">BALANCED POWER</p><p id="fighter-bio">A commanding all-round fighter.</p><div class="stat"><span>POWER</span><b id="power-stat">8</b></div><div class="stat"><span>SPEED</span><b id="speed-stat">7</b></div><div class="stat"><span>DEFENSE</span><b id="defense-stat">8</b></div><button id="confirm-fighter" class="primary full">CONFIRM FIGHTER</button></aside></div>
      <div id="select-hints" class="select-hints"></div>
    </section>
    <section id="stage" class="screen hidden">
      <div class="select-title stage-title"><img class="st-crown" src="assets/ui/crown.webp" alt=""><h2 class="st-main st-small">KING <small>OF THE</small> JUNGLE</h2><p class="st-eyebrow">STAGE SELECT</p><h3 class="st-big">CHOOSE YOUR ARENA</h3><p id="stage-vs">LION VS WOLF</p></div>
      <div id="stage-grid" class="stage-grid"></div>
      <div class="stage-actions"><button id="stage-back" class="secondary hexbtn">BACK</button><button id="stage-go" class="primary hexbtn go">FIGHT!</button></div>
    </section>
    <section id="fight" class="screen hidden">
      <div class="fight-hud"><div class="player-hud"><div class="player-label"><img id="p1-face" class="hud-face" alt=""><span id="p1-tag">PLAYER 1</span> <strong id="p1-name">LION</strong></div><div class="health-track"><div id="p1-pot" class="health-pot"></div><div id="p1-health" class="health-fill"></div></div><div class="bar-pips" id="p1-pips"><i></i><i></i></div></div><div class="round-info"><span id="mode-label">VERSUS</span><strong id="timer">99</strong><small id="round-label">ROUND 1</small></div><div class="player-hud right"><div class="player-label"><span id="p2-tag">PLAYER 2</span> <strong id="p2-name">TIGER</strong><img id="p2-face" class="hud-face" alt=""></div><div class="health-track"><div id="p2-pot" class="health-pot"></div><div id="p2-health" class="health-fill"></div></div><div class="bar-pips" id="p2-pips"><i></i><i></i></div></div></div>
      <div id="majic-boss-hud" class="majic-boss-hud hidden" aria-live="polite">
        <div class="majic-boss-heading"><span>FINAL BOSS</span><strong id="majic-boss-phase-name">PHASE I · THE JUNGLE TITAN</strong><span id="majic-boss-status">THE SUMMIT</span></div>
        <div class="majic-boss-track"><div id="majic-boss-health" class="majic-boss-health"></div></div>
        <div class="majic-phase-track"><div class="majic-phase-segment" data-phase="1"><i></i><b>I · FROST GUARD</b></div><div class="majic-phase-segment" data-phase="2"><i></i><b>II · JUNGLE RAGE</b></div><div class="majic-phase-segment" data-phase="3"><i></i><b>III · TRUE TITAN</b></div></div>
      </div>
      <div class="combat-readouts"><div class="combo-readout" id="p1-combo">0 HIT COMBO</div><div class="combat-center" id="combat-callout">FIGHT!</div><div class="combo-readout" id="p2-combo">0 HIT COMBO</div></div>
      <div class="arena"><div class="arena-sun"></div><div class="arena-back"></div><div class="arena-floor"></div><canvas id="game-canvas" width="1100" height="520" aria-label="Fighting game arena"></canvas><div class="arena-title" id="arena-title">JUNGLE TEMPLE</div><div class="rotate-hint">↻ Turn your phone sideways for full-screen fights</div></div>
      <div id="touch-pad" class="touch-pad hidden">
        <div class="pad-left"><button data-k="l" aria-label="Move left">◀</button><button data-k="j" aria-label="Jump">▲</button><button data-k="r" aria-label="Move right">▶</button><button data-k="bl" class="wide" aria-label="Block">BLOCK</button></div>
        <div class="pad-right"><button data-k="ins" class="ins" aria-label="Instinct">INS</button><button data-k="sp" class="sp" aria-label="Special">SPC</button><button data-k="at" class="at" aria-label="Attack">ATK</button></div>
      </div>
      <div class="controls" id="controls"></div>
      <div class="meter-row"><div class="meter-panel"><span>P1 INSTINCT</span><div class="meter-track"><div id="p1-meter" class="meter-fill"></div></div></div><div class="breaker-hint">COMBO: ATTACK → ATTACK (auto-double) → SPECIAL (ender) · GETTING COMBOED? TAP ATTACK ON THE GOLD FLASH TO BREAK</div><div class="meter-panel right"><span>P2 INSTINCT</span><div class="meter-track"><div id="p2-meter" class="meter-fill"></div></div></div></div>
      <div class="fight-actions"><button id="pause" class="secondary">PAUSE</button><button id="back-menu" class="secondary">MAIN MENU</button><button id="sound" class="secondary">SOUND: ON</button><button id="fullscreen" class="secondary">FULL SCREEN</button><button class="secondary blood-btn">BLOOD: OFF</button></div>
    </section>
    <section id="result" class="screen result-screen hidden"><div class="winner-art"><div class="winner-burst"></div><img id="winner-portrait" alt=""><img class="winner-crown" src="assets/ui/crown.webp" alt=""></div><p class="eyebrow">THE ARENA HAS SPOKEN</p><h2 id="winner-title">PLAYER 1 WINS</h2><p id="winner-copy">The crown belongs to the victor.</p><div id="tower-ladder" class="tower-ladder"></div><button id="tower-next" class="primary hidden">NEXT FIGHT</button><button id="rematch" class="primary">REMATCH</button><button id="result-menu" class="secondary">MAIN MENU</button></section>
    <section id="story" class="screen story-screen hidden"><div id="story-fig" class="story-fig"></div><div class="story-card"><img id="story-face" alt=""><p class="eyebrow" id="story-eyebrow"></p><h2 id="story-title"></h2><div id="story-text"></div><button id="story-next" class="primary">CONTINUE</button></div></section>
    <section id="champion" class="screen champion-screen hidden"><canvas id="champ-canvas"></canvas><div class="champ-text"><p class="eyebrow">TOWER CONQUERED</p><h2>KING OF THE JUNGLE</h2><p class="champ-name" id="champ-name"></p><p id="champ-copy"></p><p id="champ-crowns" class="champ-crowns"></p><p id="champ-unlock" class="champ-unlock hidden">NEW FIGHTER UNLOCKED · MAJIC IS NOW PLAYABLE</p></div><div id="champ-credits" class="champ-credits"></div><button id="champ-continue" class="primary champ-continue">CONTINUE</button></section>
    <section id="rise" class="screen hidden rise-screen"><video id="rise-video" playsinline preload="none" poster="assets/cinema/rise-poster.jpg"></video><button id="rise-play" class="rise-play hidden">▶ PLAY</button><button id="rise-skip" class="rise-skip">SKIP ▸</button></section>
    <section id="recovery" class="screen hidden recovery-screen"><canvas id="recovery-canvas"></canvas><div class="rec-cap"><p class="rec-eyebrow">CAE'S CORNER</p><h2>RECOVERY TIME</h2><p id="recovery-name"></p></div><p class="rec-skip">TAP OR PRESS ANY BUTTON TO CONTINUE</p></section>
    <section id="online" class="screen hidden online-screen">
      <div class="select-title"><img class="st-crown" src="assets/ui/crown.webp" alt=""><h2 class="st-main">PLAY <small>ONLINE</small></h2><p class="st-sub">FIGHT A FRIEND</p></div>
      <div class="online-box">
        <div id="ol-home">
          <button id="ol-create" class="primary ol-big"><b>CREATE MATCH</b><small>Get a code to send a friend</small></button>
          <div class="ol-or"><span>OR</span></div>
          <label class="ol-label" for="ol-code">GOT A CODE?</label>
          <div class="ol-join-row"><input id="ol-code" placeholder="TIGER-427" maxlength="14" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="characters" enterkeyhint="go"><button id="ol-join" class="primary">JOIN</button></div>
        </div>
        <div id="ol-host" class="hidden">
          <p class="ol-label">YOUR MATCH CODE</p>
          <div id="ol-mycode" class="ol-code">-----</div>
          <button id="ol-share" class="primary ol-big"><b>SEND CODE</b><small>Text it to a friend or family member</small></button>
          <p class="ol-wait"><i></i>Waiting for your friend to join…</p>
          <button id="ol-cancel" class="secondary">CANCEL</button>
        </div>
        <p id="ol-status" class="ol-status"></p>
        <button id="ol-back" class="secondary ol-back">BACK</button>
      </div>
    </section>
    <footer><span>© KING OF THE JUNGLE</span><span>Created and Developed by J. Hardy</span></footer>
  </main>
  <script src="js/roster.js?v=7.1"></script><script src="js/story.js?v=7.7"></script><script src="js/sprites-hd.js?v=8.0"></script><script src="js/audio.js?v=9.12"></script><script src="js/hitboxes.js?v=8.0"></script><script src="js/net.js?v=7.1"></script><script src="js/game.js?v=9.12"></script>
<script>(function(){var last=0;
document.addEventListener('gesturestart',function(e){e.preventDefault()},{passive:false});
document.addEventListener('gesturechange',function(e){e.preventDefault()},{passive:false});
document.addEventListener('touchmove',function(e){if(e.touches.length>1)e.preventDefault()},{passive:false});
document.addEventListener('touchend',function(e){var n=Date.now();if(n-last<350&&!(e.target.closest&&e.target.closest('input,textarea,select')))e.preventDefault();last=n},{passive:false});
document.addEventListener('wheel',function(e){if(e.ctrlKey)e.preventDefault()},{passive:false});
document.addEventListener('keydown',function(e){if((e.ctrlKey||e.metaKey)&&/^(=|\+|-|_|0)$/.test(e.key))e.preventDefault()});
document.addEventListener('contextmenu',function(e){if(document.body.classList.contains('fighting'))e.preventDefault()});})();</script>
</body></html>
